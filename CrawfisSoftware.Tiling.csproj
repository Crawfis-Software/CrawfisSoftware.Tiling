<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>CrawfisSoftware.Tiling</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>CrawfisSoftware.Tiling</AssemblyName>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>CrawfisSoftware.Tiling</PackageId>
    <Version>0.1.0</Version>
    <Authors>CrawfisSoftware</Authors>
    <Description>Abstract tiling framework with flexible tile enumeration and tile determination (selection) classes</Description>
    <RepositoryUrl>https://github.com/Crawfis-Software/CrawfisSoftware.Tiling</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Crawfis-Software/CrawfisSoftware.Tiling</PackageProjectUrl>
    <PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Please see CHANGELOG.md for release details.</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <IsPackable>true</IsPackable>
    <SignAssembly>False</SignAssembly>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Abstract tiling framework with flexible tile enumeration and tile determination (selection) classes</Title>
    <PackageTags>tiling; tileset; tile; Unity</PackageTags>

    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">

    <DocumentationFile>$(SolutionDir)bin\Documentation\CrawfisSoftware.Tiling.xml</DocumentationFile>

    <OutputPath>$(SolutionDir)bin\Debug\</OutputPath>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <CodeAnalysisRuleSet>MinimumRecommendedRules.ruleset</CodeAnalysisRuleSet>

    <DocumentationFile>$(SolutionDir)\Documentation\CrawfisSoftware.Tiling.xml</DocumentationFile>

  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".github\workflows\package.yml" />
    <None Include=".github\workflows\release-please.yml" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="LICENSE.txt" Pack="true" PackagePath="" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="" />
    <None Include="llms.txt" Pack="true" PackagePath="" Condition="Exists('llms.txt')" />
  </ItemGroup>
</Project>